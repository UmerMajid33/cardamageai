# Copy this file to .env and fill in your key. Never commit .env.
GROQ_API_KEY=

# Currently the only vision-capable model on Groq.
DAMAGESCAN_MODEL=qwen/qwen3.6-27b

# Assessment wants determinism, not flair.
DAMAGESCAN_TEMPERATURE=0.2

# Reserved output per call. Counted against the free tier's 8000
# tokens-per-minute budget even when unused, so keep it modest.
DAMAGESCAN_MAX_TOKENS=3500
